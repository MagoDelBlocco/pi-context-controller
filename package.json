  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "compact",
    "compaction"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.75.4",
    "@earendil-works/pi-coding-agent": ">=0.74.0 <1.0.0",
