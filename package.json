  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "node-addon-api": "^8.7.0"
  },
  "devDependencies": {
    "node-gyp": "^11.0.0",
    "tsx": "^4.0.0"
  }
